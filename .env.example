# Local address. For a server, set this to https://lab.example.com/.
URL_SITE=http://localhost:8080/
APP_PORT=8080
# Interface onde a porta do Apache é publicada. Mantenha 127.0.0.1: com
# compose.server.yaml quem atende a internet é o Caddy (HTTPS), que fala com o
# serviço "web" pela rede interna do Compose. Com 0.0.0.0 o laboratório fica
# acessível também em HTTP puro na porta acima, contornando o TLS.
APP_BIND_ADDRESS=127.0.0.1

# Required only with compose.server.yaml. Use the hostname without https://.
# DOMAIN=lab.example.com

MYSQL_DATABASE=quimica
MYSQL_USER=nealice
MYSQL_PASSWORD=change-this-application-password
MYSQL_ROOT_PASSWORD=change-this-root-password
